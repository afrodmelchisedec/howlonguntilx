# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/howlonguntilx"

# Auth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# API
INTERNAL_API_SECRET="random-secret"

# Rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# ── SEO pipeline (DataForSEO) — added by setup-seo-pipeline.cjs ──
# Used by scripts/seo-pipeline/seo_pipeline_v1.py, and by any future
# server-triggered pipeline run. Add the SAME two names (with real values)
# to your deployment host's environment variables UI (e.g. Netlify:
# Site settings -> Environment variables) for a non-local run.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# ── SEO admin dashboard (bearer token) — added by setup-seo-admin.cjs ──
# Used by src/app/api/admin/events/import/route.ts to authenticate
# server-to-server calls (the Python pipeline, or a future dashboard
# server action) without a browser session. Add the SAME name (with
# the real generated value) to Netlify -> Site settings -> Environment
# variables for any deployed/server-triggered run.
SEO_PIPELINE_TOKEN=
