model Reviewer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  credentials String?
  title       String?
  specialty   String?
  bio         String   @db.Text
  photoUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  articles Article[]
  events   Event[]
}

model LaborOnsetPredictorConfig {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  mucusPlugDate     DateTime?
  babyDropped       Boolean   @default(false)
  babyDroppedDate   DateTime?
  waterBroke        Boolean   @default(false)
  waterBrokeDate    DateTime?
  contractionLog    Json? // Array<{ start: string; end: string }>
  notifyOnThreshold Boolean   @default(false)
  shareLink         String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model BirthControlEffectivenessConfig {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id])
  method                 String // 'PILL_COMBINED' | 'PILL_MINI' | 'PATCH' | 'RING' | 'SHOT' | 'IUD_HORMONAL' | 'IUD_COPPER' | 'IMPLANT' | 'PLAN_B' | 'CONDOM'
  startDate              DateTime?
  cycleDayAtStart        Int? // 1-28, slider input — day of cycle the method was started
  intercourseAt          DateTime? // Plan B only
  refillReminderDays     Int?      @default(3) // Pro: remind X days before refill/expiration
  refillDate             DateTime? // Pro
  expirationDate         DateTime? // Pro: IUD/implant multi-year expiry
  methodHistory          Json? // Pro: Array<{ method, startDate, endDate }>
  notifyOnFullyEffective Boolean   @default(false)
  shareLink              String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model NewbornMilestoneTrackerConfig {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  birthDate         DateTime?
  weightEntries     Json? // Array<{ date, valueKg }>
  lengthEntries     Json? // Array<{ date, valueCm }>
  milestoneNotes    Json? // Array<{ milestoneId, note, loggedAt }>
  notifyOnMilestone Boolean   @default(false)
  shareLink         String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model KittenGrowthTrackerConfig {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate     DateTime?
  breedSize     String? // 'SMALL' | 'MEDIUM' | 'LARGE' — affects fully-grown estimate only
  weightEntries Json? // Array<{ date, valueKg }>
  milestoneLog  Json? // Array<{ milestoneId, actualDate, note }>
  litterMates   Json? // Array<{ id, label, birthDate, breedSize }> — Pro, up to 5
  shareLink     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model EggHatchTrackerConfig {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  species       String // 'CHICKEN' | 'DUCK' | 'GOOSE' | 'BLUEBIRD' | 'DOVE' | 'EAGLE' | 'HOUSE_FINCH' | 'GENERIC_BIRD'
  incubatorType String? // 'STILL_AIR' | 'FORCED_AIR' — incubator-mode species only
  startDate     DateTime?
  turningLog    Json? // Array<{ day, turnedAt }> — incubator-mode species only
  eggBatch      Json? // Array<{ id, label, candledViable, notes }> — Pro, up to 12
  shareLink     String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GardenGrowthTrackerConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  beds          Json? // Array<{ id, name, plant, plantedDate, season }>
  notifyOnStage Boolean  @default(false)
  shareLink     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PluginRelease {
  id            String   @id @default(cuid())
  slug          String // e.g. "until-x-tools"
  version       String // semver, e.g. "1.0.0"
  changelogNote String?
  isLatest      Boolean  @default(false)
  downloadCount Int      @default(0)
  filePath      String // relative path under storage/plugin-releases/
  fileSize      Int
  createdAt     DateTime @default(now())

  @@unique([slug, version])
  @@index([slug, isLatest])
}

// ── UserEvent (Community) — added Phase 1 ──────────────────────────
model UserEvent {
  id               String                    @id @default(cuid())
  slug             String                    @unique
  title            String
  description      String
  targetDate       DateTime
  images           Json?
  visibility       UserEventVisibility       @default(PUBLIC)
  moderationStatus UserEventModerationStatus @default(APPROVED)
  moderatedById    String?
  moderatedAt      DateTime?
  moderationNote   String?
  authorId         String
  author           User                      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?                 @relation(fields: [categoryId], references: [id])
  likeCount        Int                       @default(0)
  shareCount       Int                       @default(0)
  shareBreakdown   Json?
  commentCount     Int                       @default(0)
  viewCount        Int                       @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  likes            UserEventLike[]

  @@index([visibility, moderationStatus, createdAt])
  @@index([visibility, moderationStatus, likeCount])
  @@index([categoryId])
  @@index([authorId])
}

enum UserEventVisibility {
  PUBLIC
  PRIVATE
}

enum UserEventModerationStatus {
  APPROVED
  REJECTED
  REMOVED
}

model UserEventLike {
  id          String    @id @default(cuid())
  userId      String
  userEventId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEvent   UserEvent @relation(fields: [userEventId], references: [id], onDelete: Cascade)

  @@unique([userId, userEventId])
}

model Comment {
  id          String        @id @default(cuid())
  subjectType String // 'article' | 'event' | 'userEvent' | 'tool'
  subjectId   String // Article.id / Event.id / UserEvent.id / tool route slug (no FK for 'tool')
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  body        String
  likeCount   Int           @default(0)
  deletedAt   DateTime?
  flaggedAt   DateTime?
  flagReason  String?
  flaggedById String?
  flaggedBy   User?         @relation("CommentFlags", fields: [flaggedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  likes       CommentLike[]

  @@index([subjectType, subjectId, parentId])
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

// New model — deliberately NOT reusing the existing `Follow { userId, eventId }`
// model (that means "follow a countdown/Event", unrelated to following a person —
// flagged as a naming collision back in Phase 8.5 planning).
model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

// Singleton, set-once-only by design (per the resolved decision — no admin
// UI to change it once set, and the API layer refuses a second write).
// Mirrors LeadMagnetConfig's "singleton row" pattern already in the schema.
model DefaultFollowConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("DefaultFollowTarget", fields: [userId], references: [id], onDelete: Restrict)
  setById   String?
  setBy     User?    @relation("DefaultFollowSetBy", fields: [setById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
