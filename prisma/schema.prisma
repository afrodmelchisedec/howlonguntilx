// Source-of-truth actuarial data, admin-editable/importable, versioned by
// sourceYear so you can add a newer release without deleting the old one
// (compute always queries the latest sourceYear per region+sex+age).
model LifeExpectancyTable {
  id             String   @id @default(cuid())
  region         String   // 'US' | 'EUROPE' | 'AFRICA' | 'MIDDLE_EAST' | 'CHINA' | 'INDIA'
  countryLabel   String   // display label, e.g. "United States", "European Union (avg)"
  sex            Sex
  age            Int      // single year of age, 0–110
  remainingYears Float    // life expectancy AT this age, i.e. average years left
  source         String   // e.g. "CDC NVSS U.S. Life Tables"
  sourceUrl      String?
  published      Boolean  @default(false)   // <-- add this line
  sourceYear     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([region, sex, age, sourceYear])
  @@index([region, sex, sourceYear])
}

enum Sex {
  MALE
  FEMALE
}

// One row per Pro user — lets the countdown timer persist across visits
// instead of resetting on every reload (the free-tier tease).
model LifeExpectancyProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region        String
  age           Int
  sex           Sex
  factors       Json     // { smoking: boolean, exercise: boolean, ... }
  familyMembers Json?    // [{ label, age, sex, region }] — self-entered, not public figures
  expectedAge   Float    // computed result, cached so the timer target is stable
  targetDate    DateTime // now() + remaining years at time of save
  updatedAt     DateTime @updatedAt
}

// ── ADD these relation fields inside the existing `model User { ... }` block ─
//   lifeExpectancyProfile  LifeExpectancyProfile?

enum LeadRegion {
  AMERICAS
  EUROPE
  ASIA
  AFRICA
  MIDDLE_EAST
  AUSTRALIA
}

// Singleton row (always fetched/updated by a fixed id) holding the
// sitewide lead magnet banner's editable content.
model LeadMagnetConfig {
  id          String   @id @default(cuid())
  headline    String   @default("Get the free 2026–2027 Event Calendar")
  description String   @default("50+ dates worth planning around — holidays, sports finals, tax deadlines, eclipses and more — delivered to your inbox.")
  ctaLabel    String   @default("Send me the calendar")
  fileUrl     String   @default("")
  active      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// Lightweight capture table — deliberately NOT your full User/auth model.
// No password, no account, just a marketing contact tied to a download.
model LeadMagnetSubscriber {
  id        String     @id @default(cuid())
  name      String
  email     String
  region    LeadRegion
  source    String     @default("global_banner")
  createdAt DateTime   @default(now())

  // Same email can exist once per "source" — lets you reuse this table
  // for a second lead magnet later without colliding on email alone.
  @@unique([email, source])
  @@index([region])
  @@index([createdAt])
}
