model Article {
  id           String    @id @default(cuid())
  toolSlug     String // e.g. "tech-events" — links article to its parent tool/category
  slug         String
  title        String
  dek          String // one-line SEO/social summary
  heroImageUrl String? // must be >=1200px wide when set
  heroImageAlt String?
  authorName   String    @default("Afrod M (Msc Statistics at Makerere University)")
  blocks       Json // typed block array, see ArticleBlocks.tsx
  status       String    @default("draft") // draft | published | archived
  contentType  String    @default("evergreen") // evergreen | breaking
  publishedAt  DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())
  likeCount    Int       @default(0)
  likes        ArticleLike[]

  categoryId    String?
  category      Category?     @relation("ArticleCategory", fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Category?     @relation("ArticleSubcategory", fields: [subcategoryId], references: [id])
  questionType  QuestionType?
  heroData      Json?

  reviewerName        String?
  reviewerCredentials String?

  @@unique([toolSlug, slug])
  @@index([toolSlug, status, publishedAt])
  @@index([categoryId])
  @@index([subcategoryId])
}



enum QuestionType {
  DURATION
  DATED
}

model FeaturedPiece {
  id          String    @id @default(cuid())
  kind        String    // "history" | "fact" | "quote" | "meme"
