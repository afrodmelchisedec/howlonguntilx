model Payment {
  id                   String      @id @default(cuid())
  userId               String?
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail            String?     // snapshot, survives user deletion
  paypalTransactionId  String      @unique  // PayPal sale/refund id — makes webhook inserts idempotent
  paypalSubscriptionId String?
  eventType            String      // raw PayPal event_type, e.g. "PAYMENT.SALE.COMPLETED"
  type                 PaymentType @default(SALE)
  amountCents          Int         // always positive; use `type` to determine sign in reports
  currency             String      @default("USD")
  createdAt            DateTime    @default(now())

  @@index([userId])
  @@index([paypalSubscriptionId])
  @@index([createdAt])
}

enum PaymentType {
  SALE
  REFUND
}

