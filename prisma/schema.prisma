// FILE: prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String             @id @default(cuid())
  name                 String?
  email                String?            @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  paypalId             String?            @unique
  paypalSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(none)
  planRenewsAt         DateTime?
  trialEndsAt          DateTime?
  plan                 Plan               @default(FREE)
  eventCount           Int                @default(0)
  articleLikes         ArticleLike[]
  role                 Role               @default(USER)
  createdAt            DateTime           @default(now())
  lastSeen             DateTime?
  username             String?            @unique
  blockedAt            DateTime?
  blockedById          String?
  blockReason          String?
  blockedBy            User?              @relation("UserBlocks", fields: [blockedById], references: [id], onDelete: SetNull)
  blockedUsers         User[]             @relation("UserBlocks")
  flaggedComments      Comment[]          @relation("CommentFlags")

  apiKeys                         ApiKey[]
  accounts                        Account[]
  sessions                        Session[]
  timers                          Timer[]
  likes                           Like[]
  follows                         Follow[]
  meetingOverlapConfig            MeetingOverlapConfig?
  recipeBatchConfig               RecipeBatchConfig?
  deadlineBufferConfig            DeadlineBufferConfig?
  savingsGoalConfig               SavingsGoalConfig?
  jetlagConfig                    JetlagConfig?
  passwordRotationConfig          PasswordRotationConfig?
  focusBlockConfig                FocusBlockConfig?
  calendarSavedDays               CalendarSavedDays?
  moneyMilestonesConfig           MoneyMilestonesConfig?
  taxDeadlineConfig               TaxDeadlineConfig?
  payrollConfig                   PayrollConfig?
  foodFestivalConfig              FoodFestivalConfig?
  restaurantWatchlistConfig       RestaurantWatchlistConfig?
  harvestSeasonsConfig            HarvestSeasonsConfig?
  sportsGamesConfig               SportsGamesConfig?
  entertainmentConfig             EntertainmentConfig?
  energyRhythmConfig              EnergyRhythmConfig?
  symptomTrackerConfig            SymptomTrackerConfig?
  fraudResponseConfig             FraudResponseConfig?
  phishingIdentityConfig          PhishingIdentityConfig?
  darkSkyConfig                   DarkSkyConfig?
  techEventsConfig                TechEventsConfig?
  shoppingDealsConfig             ShoppingDealsConfig?
  payments                        Payment[]
  lifeExpectancyProfile           LifeExpectancyProfile?
  amIPregnantTrackerConfig        AmIPregnantTrackerConfig?
  petGrowthGestationConfig        PetGrowthGestationConfig?
  laborOnsetPredictorConfig       LaborOnsetPredictorConfig?
  birthControlEffectivenessConfig BirthControlEffectivenessConfig?
  newbornMilestoneTrackerConfig   NewbornMilestoneTrackerConfig?
  gardenGrowthTrackerConfig       GardenGrowthTrackerConfig?
  kittenGrowthTrackerConfig       KittenGrowthTrackerConfig?
  eggHatchTrackerConfig           EggHatchTrackerConfig?
  userEvents                      UserEvent[]
  userEventLikes                  UserEventLike[]
  comments                        Comment[]
  commentLikes                    CommentLike[]
  following                       UserFollow[]                     @relation("UserFollowFollower")
  followers                       UserFollow[]                     @relation("UserFollowFollowing")
  defaultFollowTargetOf           DefaultFollowConfig?             @relation("DefaultFollowTarget")
  defaultFollowSetBy              DefaultFollowConfig[]            @relation("DefaultFollowSetBy")
}

enum Plan {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
}

model Timer {
  id         String   @id @default(cuid())
  userId     String
  name       String
  targetDate DateTime
  category   String   @default("personal")
  isPublic   Boolean  @default(false)
  slug       String?  @unique
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                  String    @id @default(cuid())
  slug                String    @unique
  name                String
  description         String?
  targetDate          DateTime
  type                EventType @default(COUNTDOWN)
  categoryId          String?
  category            Category? @relation("EventCategory", fields: [categoryId], references: [id])
  subcategoryId       String?
  subcategory         Category? @relation("EventSubcategory", fields: [subcategoryId], references: [id])
  categorySlug        String    @default("leisure")
  heroImageUrl        String?
  heroImageAlt        String?
  authorName          String    @default("Afrod M (Msc Statistics at Makerere University)")
  reviewerName        String?
  reviewerCredentials String?
  reviewerId          String?
  reviewer            Reviewer? @relation(fields: [reviewerId], references: [id])
  reviewEnabled       Boolean   @default(false)
  reviewedAt          DateTime?
  published           Boolean   @default(true)
  publishedAt         DateTime?
  archived            Boolean   @default(false)
  userId              String?
  locale              String    @default("en")
  views               Int       @default(0)
  likeCount           Int       @default(0)
  followCount         Int       @default(0)
  shareCount          Int       @default(0)
  shareBreakdown      Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  content             Json?

  likes   Like[]
  follows Follow[]

  @@index([categoryId])
  @@index([subcategoryId])
}

enum EventType {
  COUNTDOWN
  ELAPSED
  RELATIVE
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model ArticleLike {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
