// Also add inside `model User { ... }`:  articles Article[]  (only if you want an authorId relation — optional, see authorName fallback below)

model Article {
  id             String        @id @default(cuid())
  toolSlug       String // e.g. "tech-events" — links article to its parent tool/category
  slug           String
  title          String
  dek            String // one-line SEO/social summary
  heroImageUrl   String? // must be >=1200px wide when set
  heroImageAlt   String?
  authorName     String        @default("Afrod M (Msc Statistics at Makerere University)")
  blocks         Json // typed block array, see ArticleBlocks.tsx
  status         String        @default("draft") // draft | published | archived
  contentType    String        @default("evergreen") // evergreen | breaking
  publishedAt    DateTime?
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())
  likeCount      Int           @default(0)
  shareCount     Int           @default(0)
  shareBreakdown Json?
  likes          ArticleLike[]

  categoryId    String?
  category      Category?     @relation("ArticleCategory", fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory   Category?     @relation("ArticleSubcategory", fields: [subcategoryId], references: [id])
  questionType  QuestionType?
  heroData      Json?

  reviewerName        String?
  reviewerCredentials String?
  reviewerId          String?
  reviewer            Reviewer? @relation(fields: [reviewerId], references: [id])
  reviewEnabled       Boolean   @default(false)
  reviewedAt          DateTime?

  @@unique([toolSlug, slug])
  @@index([toolSlug, status, publishedAt])
  @@index([categoryId])
  @@index([subcategoryId])
}

enum QuestionType {
  DURATION
  DATED
}

